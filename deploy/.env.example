# Generated by setup-ip.sh. Never commit the populated deploy/.env file.
CORELINE_IPV4=203.0.113.10
POSTGRES_DB=coreline
POSTGRES_USER=coreline
POSTGRES_PASSWORD=replace-with-a-random-secret
DATABASE_URL=postgresql+psycopg://coreline:replace-with-a-random-secret@db:5432/coreline

# The GitHub Pages origin is intentionally exact; no wildcard CORS.
CORS_ORIGINS=https://weeeedddd.github.io
MEDIA_DIR=/app/media
PUBLIC_INTEGRATIONS_ENABLED=false

# Closed-app Web Push. setup-ip.sh generates the key pair and cron secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://203.0.113.10
PUSH_CRON_SECRET=replace-with-a-random-secret

# Optional providers stay disabled until authenticated quotas and budgets exist.
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=

INTEGRATION_TIMEOUT_SECONDS=15
INTEGRATION_MAX_REQUEST_BYTES=32768
INTEGRATION_MAX_RESPONSE_BYTES=524288
AI_PLAN_RATE_LIMIT_PER_MINUTE=6
AI_ASSISTANT_RATE_LIMIT_PER_MINUTE=12
STORE_SEARCH_RATE_LIMIT_PER_MINUTE=20
