# SHADOW~1 Backend — Konfiguration (alle Werte optional)

# SQL-Datenbank: Default ist SQLite im backend/-Ordner.
# Für Postgres z. B.: postgresql+psycopg://user:pass@host:5432/shadow
DATABASE_URL=sqlite:///./shadow.db

# Erlaubte Frontend-Origins, kommagetrennt.
# Für GitHub Pages z. B.: https://weeeedddd.github.io
CORS_ORIGINS=*

# Ablageort für Chat-Bilduploads
MEDIA_DIR=./media
