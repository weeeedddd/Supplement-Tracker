# CORELINE backend configuration. Keep real secrets outside source control.

# SQL database (SQLite is suitable for local development only).
DATABASE_URL=sqlite:///./shadow.db

# Exact browser origins only; CORS wildcards are rejected at startup.
CORS_ORIGINS=https://weeeedddd.github.io,http://localhost:5173,http://127.0.0.1:5173

# Existing media upload directory.
MEDIA_DIR=./media

# Remote plan drafting. Both values are required before the AI endpoint is live.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=700

# Google Maps server-side provider. A shared key can be used locally, while
# separate restricted keys are recommended in production.
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=

# Cost/abuse and resource bounds for anonymous integration endpoints.
# Default deny: do not enable this until account/guest quotas, edge limits and
# a hard provider spend cap are deliberately configured.
PUBLIC_INTEGRATIONS_ENABLED=false
INTEGRATION_TIMEOUT_SECONDS=15
INTEGRATION_MAX_REQUEST_BYTES=32768
INTEGRATION_MAX_RESPONSE_BYTES=524288
AI_PLAN_RATE_LIMIT_PER_MINUTE=6
AI_ASSISTANT_RATE_LIMIT_PER_MINUTE=12
STORE_SEARCH_RATE_LIMIT_PER_MINUTE=20
